# ---- Claude API ----
# Schluessel aus console.anthropic.com. WICHTIG: dort auch ein Ausgabenlimit setzen!
ANTHROPIC_API_KEY=sk-ant-...

# ---- Supabase ----
# Projekt-Einstellungen -> API Keys. Der geheime Schluessel (sb_secret_...) darf
# NIE oeffentlich werden. Nicht den publishable-Schluessel nehmen.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...

# ---- Telegram (ab Phase 6) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Bewerbungs-Postfach (ab Phase 7) ----
MAIL_ADDRESS=
MAIL_APP_PASSWORD=
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_IMAP_HOST=imap.gmail.com

# ---- Verhalten ----
# HEADFUL=1 -> Browser sichtbar (zum Zuschauen). Leer -> unsichtbar.
HEADFUL=
# SHOTS=1 -> von jeder aufgerufenen Seite ein Bildschirmfoto in
# engine/screenshots/ ablegen. Ersatz fuers Zuschauen, wenn kein Fenster
# aufgehen kann (z.B. spaeter in GitHub Actions).
SHOTS=
# DRY_RUN=1 -> alles machen ausser wirklich abschicken.
DRY_RUN=1
# MAIL_TEST_MODE=1 -> Bewerbungsmails gehen an MAIL_ADDRESS statt an die
# Firma (Testwoche aus dem Bauplan). Erst auf 0 stellen, wenn eine Woche lang
# alles richtig angekommen ist.
MAIL_TEST_MODE=1

# ---- Portal-Konten (ab Phase 8, fuer das automatische Bewerben) ----
# hokify, willhaben und karriere.at laufen bei Niki ueber "Mit Google
# anmelden" - dafuer gibt es kein Passwort, das hier stehen koennte. Stattdessen:
#   npm run anmelden hokify      (bzw. willhaben / karriere)
# oeffnet ein ganz normales (nicht automatisiertes) Chrome-Fenster, du loggst
# dich selbst ein, das Profil wird in engine/.auth/profil-<portal>/ gespeichert
# (siehe .gitignore - niemals einchecken, so sensibel wie ein Passwort). Ohne
# das markiert apply-browser die Anzeige als "needs_manual" und schickt dir
# per Telegram den Direktlink.

# ---- Lebenslauf ----
# Schraegstriche verwenden, nicht Backslashes.
CV_PDF_PATH=C:/Users/dein-name/Dokumente/Lebenslauf.pdf
